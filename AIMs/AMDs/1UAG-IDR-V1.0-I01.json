  "title":                "ID Reconciliation AIW V1.0 - Implementation I01",
  "Identifier":           {"ImplementerID": "MPAI", "ImplementationID": "UAG-IDR-V1.0-I01", "AIMName": "UAG-IDR-V1.0"},
  "APIProfile":           "Basic",
  "Description":          "Reconciles a face identity and a speaker identity into one. One SubAIM, ID Reconciliation, and no code of its own. The UA writes a face Instance Identifier to InputFaceID and a speaker Instance Identifier to InputSpeakerID; the Controller routes them to IDR's two OSD-IID inputs and the reconciled Instance Identifier comes back. Both IDR inputs are OSD-IID-V1.5, so DataType alone cannot tell them apart: each Topology endpoint therefore carries a PortNumber (1 = face, 2 = speaker) which the Controller appends as '#n' and the executor uses to pick the right port. This is the first wrapper to exercise PortNumber-based routing of two same-DataType inputs.",
  "ExternalPorts":        [{"Name": "InputFaceID",    "Direction": "Input",  "DataType": "OSD-IID-V1.5", "PortNumber": 1, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "InputSpeakerID", "Direction": "Input",  "DataType": "OSD-IID-V1.5", "PortNumber": 2, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "ReconciledID",   "Direction": "Output", "DataType": "OSD-IID-V1.5", "Technology": "Software", "Protocol": "", "IsRemote": false}],
  "SubAIMs":              [{ "Identifier": { "ImplementerID": "1", "ImplementationID": "HCI-IDR-V1.0-I01", "AIMName": "HCI-IDR-V1.0" } }],
  "Topology":             [{ "Output": { "AIMName": "",             "PortName": "InputFaceID"                   }, "Input": { "AIMName": "HCI-IDR-V1.0", "PortName": "FaceID"       } },
                           { "Output": { "AIMName": "",             "PortName": "InputSpeakerID"                }, "Input": { "AIMName": "HCI-IDR-V1.0", "PortName": "SpeakerID", "PortNumber": 2 } },
                           { "Output": { "AIMName": "HCI-IDR-V1.0", "PortName": "ReconciledID"                  }, "Input": { "AIMName": "",             "PortName": "ReconciledID" } }],
