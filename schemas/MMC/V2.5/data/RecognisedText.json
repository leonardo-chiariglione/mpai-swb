{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$id":                  "https://schemas.mpai.community/MMC/V2.5/data/RecognisedText.json",
  "title":                "Recognised Text V2.5",
  "type":                 "object",
  "required":             [ "TextLines", "Header" ],
  "properties":           { 
    "Header":             { "type": "string", "const": "MMC-RTX-V2.5" },
    "MInstanceID":        { "type": "string", "description": "Identifier of M-Instance." },
    "UEnvironmentID":     { "type": "string", "description": "Identifier of the U-Environment." },
    "RecognisedTextID":   { "type": "string", "description": "Identifier of the Text Object." },
    "RecognisedTextTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json", "description": "Space-Time of Text Object." },

    "TextLines":          { "type": "array", "items": { "$ref": "#/$defs/TextLine" } } },

  "$defs":            {
    "BoundingBox":        { "type": "object", "required": [ "X", "Y", "Width", "Height" ], "properties": {
      "X":                { "type": "integer", "minimum": 0 },
      "Y":                { "type": "integer", "minimum": 0 },
      "Width":            { "type": "integer", "minimum": 0 },
      "Height":           { "type": "integer", "minimum": 0 } } },
    "TextQualifier":      { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/TextQualifier.json"},
    "TextLine":           { "type": "object", "required": [ "Text", "Confidence", "BoundingBox" ], "properties": {
      "Text":             { "type": "string" },
      "Confidence":       { "type": "number", "minimum": 0.0, "maximum": 1.0 },
      "BoundingBox":      { "$ref": "#/$defs/BoundingBox" } } } } }