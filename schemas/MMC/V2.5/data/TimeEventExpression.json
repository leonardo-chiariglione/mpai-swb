{ "$schema":                      "https://json-schema.org/draft/2020-12/schema",
  "$id":                          "https://schemas.mpai.community/MMC/V2.5/data/TimeEventExpression.json",
  "title":                        "Time-Event-Expression V2.5",
  "type":                         "object",
 																		"required": [ "Header", "Participants", "FunctionalSegments", "CommunicativeFunctions", "DialogueActs" ],
  "description":                  "capturES the core components of ISO 24617-2 DiAML: dialogue acts, functional segments, participants, dimensions, communicative functions, qualifiers, dependence relations, and rhetorical relations.",
  "additionalProperties":         false,

  "$defs":                     		{ },

    "properties":                 {

    "Header":                     { "type": "string", "const": "MMC-TEE-V2.5" },
    "MInstanceID":                { "type": "string" },
    "MEnvironmentID":             { "type": "string" },
    "TimeEventExpressionID":    	{ "type": "string" },
    "TimeEventExpressionTime":  	{ "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "Participants":               { "type": "array", "uniqueItems": true, "items": { "type": "object", "required": [ "id","role" ], "properties": {
                                    "id":       { "type": "string" },
                                    "role":     { "type": "string",
                                                  "enum": [ "speaker","addressee","audience","system","other" ] },
                                    "type":     { "type": "string",
                                                  "enum": [ "human","agent","system" ] },
                                    "label":    { "type": "string" },
                                    "metadata": { "type": "object" } } } },

    "FunctionalSegments":         { "type": "array", "items": { "type": "object", "required": [ "id","source","modality" ], "properties": {
                                    "id":         { "type": "string" },
                                    "source":     { "type": "string" },
                                    "modality":   { "type": "string", "enum": [ "text","speech","gesture","multimodal","other" ] },
                                    "language":   { "type": "string" },
                                    "start":      { "type": "number" },
                                    "end":        { "type": "number" },
                                    "offsetType": { "type": "string", "enum": [ "char","token","ms","frame","sample" ] },
                                    "text":       { "type": "string" } } } },

    "CommunicativeFunctions":     { "type": "array", "description": "Registry of communicative functions used in this annotation instance (optionally referencing an external vocabulary).", "items": { "type": "object", "required": [ "id","label","dimension" ], "properties": {
                                    "id":        { "type": "string" },
                                    "label":     { "type": "string" },
                                    "dimension": { "type": "string",
                                                   "enum": [ "Task","Feedback","TurnManagement","TimeManagement", "DiscourseStructuring","OwnCommunicationManagement", "PartnerCommunicationManagement", "SocialObligationsManagement" ] },
                                    "definition":{ "type": "string" },
                                    "uri":       { "type": "string" } } } },

    "DialogueActs":               { "type": "array", "items": { "type": "object",
                                    "required": [ "id","segmentRef","senderRef","functionRef","dimension" ], "properties": {
                                    "id":            { "type": "string" },
                                    "segmentRef":    { "type": "string" },
                                    "senderRef":     { "type": "string" },
                                    "addresseeRefs": { "type": "array", "items": { "type": "string" } },
                                    "functionRef":   { "type": "string", "description": "Reference to communicativeFunctions[id]" },
                                    "dimension":     { "type": "string",
                                                       "enum": [ "Task","Feedback","TurnManagement","TimeManagement", "DiscourseStructuring","OwnCommunicationManagement", "PartnerCommunicationManagement","SocialObligationsManagement" ] },
                                    "semanticContent":{ "type": "object",
                                                        "description": "Optional container for semantic content (propositions, TER linkage, etc.)" },
                                    "qualifiers":     { "type": "object", "properties": {
                                                         "sentiment":   { "type": "string" },
                                                         "certainty":   { "type": "number", "minimum": 0, "maximum": 1 },
                                                         "conditional": { "type": "boolean" } } },
                                    "dependence":     { "type": "object", "properties": {
                                                         "functional": { "type": "string", "description": "DialogueAct[id] this act depends on." },
                                                         "feedback":   { "type": "string", "description": "DialogueAct[id] this act gives feedback to." } } },
                                    "rhetoricalRelations": { "type": "array", "items": { "type": "object", "required": [ "type","targetActRef" ], "properties": {
                                                                "type":         { "type": "string" },
                                                                "targetActRef": { "type": "string" } } } },
                                    "LocalTrace":     { "type": "object", "properties": {
                                                         "origin":    { "type": "string" },
                                                         "timestamp": { "type": "string", "format": "date-time" },
                                                         "tool":      { "type": "string" },
                                                         "version":   { "type": "string" } } } } } },

    "Relations":                  { "type": "array", "description": "Non-dependence relations among dialogue acts (e.g., rhetorical).",
                                    "items": { "type": "object", "required": [ "id","sourceActRef","targetActRef","relationType" ], "properties": {
                                    "id":           { "type": "string" },
                                    "sourceActRef": { "type": "string" },
                                    "targetActRef": { "type": "string" },
                                    "relationType": { "type": "string" },
                                    "confidence":   { "type": "number", "minimum": 0, "maximum": 1 },
                                    "LocalTrace":   { "type": "object", "properties": {
                                                       "origin":    { "type": "string" },
                                                       "timestamp": { "type": "string", "format": "date-time" } } } } } },

    "DataXMData":     						{ "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":  						{ "type": "string", "maxLength": 2048 } } }

