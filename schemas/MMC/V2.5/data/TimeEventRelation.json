{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/MMC/V2.5/data/TimeEventRelation.json",
  "title":                    "Time Event Relation V2.5",
  "type":                     "object",
  "description":              "Temporal entities, events, and their relations supporting semantic annotations (TER).",
  "additionalProperties":     false,
  "required":                 [ "Time", "Event", "Trace" ],
  "properties":               {

    "Header":                 { "type": "string", "const": "MMC-TER-V2.5" },
    "MInstanceID":            { "type": "string" },
    "UEnvironmentID":         { "type": "string" },
    "TERAnnotationID":        { "type": "string" },

    "Time":                   { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Time" } },

    "Event":                  { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Event" } },

    "Relation":               { "type": "array", "items": { "$ref": "#/$defs/Relation" } },

    "Anchors":                { "type": "array", "items": { "$ref": "#/$defs/Anchor" } },

    "DataXMData":             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":          { "type": "string", "maxLength": 2048 } },

  "$defs":                    {

    "ID":                     { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },

    "ID_Signal":              { "type": "string", "description": "Identifier of external signal (text/audio/video), e.g., stream name.",
                                "pattern": "^[A-Za-z0-9._:-]+$" },

    "Trace":                  { "type": "object", "required": [ "origin", "timestamp" ], "additionalProperties": false, "properties": {
      "origin":               { "$ref": "https://schemas.mpai.community/AIF/V3.0/data/AIMInstance.json" },
      "timestamp":            { "$ref": "#/$defs/Time" },
      "tool":                 { "type": "string" },
      "version":              { "type": "string" } } },

    "Time":                   { "type": "object", "required": [ "timeID", "type", "value" ], "additionalProperties": false, "properties": {
      "timeID":               { "$ref": "#/$defs/ID" },
      "type":                 { "type": "string", "enum": [ "point","interval","duration" ] },
      "value":                { "oneOf": [
                              { "type": "string", "description": "ISOÃ¢â‚¬â€˜8601 timestamp for point." },
                              { "type": "object", "required": [ "start","end" ], "additionalProperties": false, "properties": {
        "start":              { "type": "string" },
        "end":                { "type": "string" } } },
                              { "type": "string", "description": "Duration (PnYnMnDTnHnMnS)." } ] },
      "timezone":             { "type": "string" },
      "calendar":             { "type": "string" },
      "uncertainty":          { "type": "string", "description": "e.g., Ã‚Â±PT5S" },
      "confidence":           { "type": "number", "minimum": 0, "maximum": 1 },
      "trace":                { "$ref": "#/$defs/Trace" } } },

    "Event":                  { "type": "object", "required": [ "eventID","type" ], "additionalProperties": false, "properties": {
      "eventID":              { "$ref": "#/$defs/ID" },
      "type":                 { "type": "string" },
      "participants":         { "type": "array", "items": { "$ref": "#/$defs/Participant" } },
      "attributes":           { "type": "object" },
      "timeRefs":             { "type": "array", "items": { "$ref": "#/$defs/ID" } },
      "anchors":              { "type": "array", "items": { "$ref": "#/$defs/Anchor" } },
      "trace":                { "$ref": "#/$defs/Trace" } } },

    "Relation":               { "type": "object", "required": [ "relationID","source","target","relationType" ], "additionalProperties": false, "properties": {
      "relationID":           { "$ref": "#/$defs/ID" },
      "source":               { "$ref": "#/$defs/ID" },
      "target":               { "$ref": "#/$defs/ID" },
      "relationType":         { "type": "string", "enum": [ "BEFORE","AFTER","DURING","OVERLAPS", "CAUSES","ENABLES","PART_OF","SEQUENCE" ] },
      "directional":          { "type": "boolean" },
      "symmetric":            { "type": "boolean" },
      "transitive":           { "type": "boolean" },
      "confidence":           { "type": "number", "minimum": 0, "maximum": 1 },
      "trace":                { "$ref": "#/$defs/Trace" } } },

    "Participant":            { "type": "object", "required": [ "id" ], "additionalProperties": false, "properties": {
      "id":                   { "$ref": "#/$defs/ID" },
      "role":                 { "type": "string" },
      "label":                { "type": "string" } } },

    "Anchor":                 { "type": "object", "required": [ "id","signalID","modality" ], "additionalProperties": false, "properties": {
      "id":                   { "$ref": "#/$defs/ID" },
      "signalID":             { "$ref": "#/$defs/ID_Signal" },
      "modality":             { "type": "string", "enum": [ "text","speech","video","image", "gesture","sensor","other" ] },
      "start":                { "type": "number" },
      "end":                  { "type": "number" },
      "offsetType":           { "type": "string", "enum": [ "char","token","ms","frame","sample" ] } } } } }
