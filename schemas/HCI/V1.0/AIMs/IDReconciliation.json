{ "$schema":              "https://schemas.mpai.community/AIF/V3.0/data/AIMMetadata.json",
  "$id":                  "https://schemas.mpai.community/HCI/V1.0/AIMs/IDReconciliation.json",
  "title":                "ID Reconciliation V1.0",

  "Identifier":           {"ImplementerID": "/* String assigned by IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "HCI-IDR-V1.0"},

  "APIProfile":           "Basic",
  "Description":          "This AIM reconciles the Identifiers of an Entity produced by two recognition modalities. It receives a face Instance Identifier and a speaker Instance Identifier, fuses their ranked candidates by score-level fusion, and produces one reconciled Instance Identifier. Either input may be absent, in which case the reconciliation degrades to the modality present.",

  "ExternalPorts":        [{"Name": "FaceID",       "Direction": "Input",  "DataType": "OSD-IID-V1.5", "PortNumber": 1, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "SpeakerID",    "Direction": "Input",  "DataType": "OSD-IID-V1.5", "PortNumber": 2, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "ReconciledID", "Direction": "Output", "DataType": "OSD-IID-V1.5", "Technology": "Software", "Protocol": "", "IsRemote": false}],

