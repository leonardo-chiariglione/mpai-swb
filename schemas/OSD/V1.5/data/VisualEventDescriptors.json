{ "$id":                                "https://schemas.mpai.community/OSD/V1.5/data/VisualEventDescriptors.json",
  "$schema":                            "https://json-schema.org/draft/2020-12/schema",
  "title":                              "VisualEvent Descriptors V1.5",
  "description":                        "VisualEvent descriptor set.",
  "type":                               "object",
  "required":                           [ "Header", "VisualEventDescriptorsID", "VisualEventDescriptorsSpaceTime" ],
  "additionalProperties":               false,
  "properties":                         {

    "Header":                           { "type": "string", "const": "OSD-VED-V1.5" },
    "MInstanceID":                      { "type": "string" },
    "UEnvironmentID":                   { "type": "string" },
    "VisualEventDescriptorsID":         { "type": "string" },
    "VisualEventDescriptorsSpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },

    "VisualEventDescriptors":           { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": {
      "VSceneIDOrVScene":               { "description": "Embedded Event Descriptors (recursive) or an Event ID (by reference).",
                                          "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/VisualSceneDescriptors.json" },
                                        { "type": "string" } ] } } } } },

    "DataXMData":                       { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                    { "type": "string", "maxLength": 2048 } } }