
{ "$schema":          "https://json-schema.org/draft/2020-12/schema",
  "$id":              "https://schemas.mpai.community/OSD/V1.5/data/AffordanceTags.json",
  "title":            "Affordance Tags V1.5",
  "type":             "object",
  "properties":       {

    "Header":         { "type": "string", "const": "OSD-AFT-V1.5" },
    "MetaverseID":              { "type": "string" },
    "UEnvironment":             { "type": "string" },

    "Tags":           { "type": "array", "items": { "type": "string",
                        "enum": ["Graspable","Touchable","Pushable","Openable","Draggable","Rotatable","Tappable","Selectable",
                        "Liftable","Insertable","Activatable"] }, "minItems": 1, "uniqueItems": true,
                        "description": "Affordance labels characterising possible actions on the object." },

    "DataXMData":     { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":  { "type": "string", "maxLength": 2048 } } }