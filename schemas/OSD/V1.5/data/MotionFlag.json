{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$id":                  "https://schemas.mpai.community/OSD/V1.5/data/MotionFlag.json",
  "title":                "Motion Flag V1.5",
  "description":          "Flag indicating motion status of an audio Entity.",
  "type":                 "object",
  "additionalProperties": false,
  "properties":           {
    "EntityID":           { "type": "string" },
    "IsMoving":           { "type": "boolean" },
    "MotionConfidence":   { "type": "number", "minimum": 0, "maximum": 1 } } }
