{ "$schema":                    "https://json-schema.org/draft/2020-12/schema",
  "$id":                        "https://schemas.mpai.community/OSD/V1.5/data/SceneDescriptors.json",
  "title":                      "Scene Descriptors V1.5",
  "type":                       "object",
  "required":                   [ "Header", "SceneDescriptorsID", "SceneDescriptorsSpaceTime" ],
  "additionalProperties":       false,
  "properties":                 {

    "Header":                   { "type": "string", "const": "OSD-SCD-V1.5" },
    "MInstanceID":              { "type": "string" },
    "UEnvironmentID":           { "type": "string" },
    "SceneDescriptorsID":       { "type": "string" },
    "SceneDescriptorsSpaceTime":{ "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },

    "ObjectCount":              { "type": "integer" },
    "Objects":                  { "type": "array", "items": { "type": "object",
                                  "additionalProperties": false, "properties": {
      "ObjectSpaceTime":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "ObjectIDOrObject":       { "$ref": "#/$defs/ObjectIDOrObject" } } } },

    "SubSceneCount":            { "type": "integer" },
    "SubScenes":                { "type": "array", "items": { "type": "object",
                                  "additionalProperties": false, "properties": {
      "SubSceneSpaceTime":      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "SubSceneIDOrSubScene":   { "$ref": "#/$defs/SubSceneIDOrSubScene" } } } },

    "BasicSceneOrScene":        { "$ref": "#/$defs/BasicSceneOrScene" },

    "DataXMData":               { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":            { "type": "string", "maxLength": 2048 } },

  "$defs":                      {

    "ObjectIDOrObject":         { "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Object.json" },
                                { "type": "string" } ] } },

    "SubSceneIDOrSubScene":     { "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SceneDescriptors.json" },
                                { "type": "string" } ] } },

    "BasicSceneOrScene":        { "type": "array", "items": { "oneOf": [
                                { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/BasicSceneDescriptors.json" },
                                { "$ref": "#/$defs/BasicSceneOrScene" } ] } } } }