{
  "$id": "https://schemas.mpai.community/OSD/V1.5/data/BasicVisualSceneDescriptors.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Basic Visual Scene Descriptors V1.5",
  "type": "object",
  "required": [
    "Header",
    "MInstanceID",
    "BasicVisualSceneDescriptorsID",
    "BVSDescriptorsSpaceTime",
    "VisualObjectCount",
    "BasicVisualSceneDescriptors"
  ],
  "additionalProperties": false,
  "properties": {
    "Header": {
      "type": "string",
      "const": "OSD-BVS-V1.5"
    },
    "MInstanceID": {
      "type": "string"
    },
    "UEnvironmentID": {
      "type": "string"
    },
    "BasicVisualSceneDescriptorsID": {
      "type": "string"
    },
    "BVSDescriptorsTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
    },
    "BVSDescriptorsSpaceTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json"
    },
    "ViewerPointOfView": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/PointOfView.json"
    },
    "GravityValue": {
      "type": "number"
    },
    "VisualObjectCount": {
      "type": "integer",
      "minimum": 0
    },
    "BasicVisualSceneDescriptors": {
      "type": "array",
      "items": {
        "$anchor": "BasicVisualSceneItem",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "VObjectIDOrVObject",
          "PointOfView"
        ],
        "properties": {
          "VisualObjectSpaceTime": {
            "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json"
          },
          "VObjectIDOrVObject": {
            "$ref": "#/$defs/ObjectIDOrObject"
          },
          "PointOfView": {
            "$ref": "https://schemas.mpai.community/OSD/V1.5/data/PointOfView.json"
          }
        }
      }
    },
    "DataXMData": {
      "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json"
    },
    "DescrMetadata": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "$defs": {
    "ObjectIDOrObject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "https://schemas.mpai.community/OSD/V1.5/data/VisualObject.json"
          },
          {
            "type": "string"
          }
        ]
      }
    }
  }
}