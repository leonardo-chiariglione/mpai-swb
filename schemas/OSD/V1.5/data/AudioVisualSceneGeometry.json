{ "$schema":                                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                                      "https://schemas.mpai.community/OSD/V1.5/data/AudioVisualSceneGeometry.json",
  "title":                                    "AudioVisualScene Geometry V1.5",
  "description":                              "Includes Objects, Basic Scene geom.-Scene geom.",
  "type":                                     "object",
  "required":                                 [ "Header", "AudioVisualSceneGeometryID", "AudioVisualSceneGeometrySpaceTime" ],
  "additionalProperties":                     false,
  "properties":                               {

    "Header":                                 { "type": "string", "const": "OSD-MSG-V1.5" },
    "MInstanceID":                            { "type": "string" },
    "UEnvironmentID":                         { "type": "string" },
    "AudioVisualSceneGeometryID":             { "type": "string" },
    "AudioVisualSceneGeometrySpaceTime":      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },

    "ObjectCount":                            { "type": "integer", "minimum": 0 },
    "Objects":                                { "type": "array", "items": { "type": "object", "additionalProperties": false,
                                                "properties":                           {
        "ObjectSpaceTime":                    { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
        "ObjectIDOrGeometry":                 { "$ref": "#/$defs/ObjectIDOrGeometry" } } } },

    "SubAudioVisualSceneCount":               { "type": "integer", "minimum": 0 },
    "SubAudioVisualScenes":                   { "type": "array", "items": { "type": "object", "additionalProperties": false,
                                                "properties": {
        "SubAudioVisualSceneSpaceTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
        "SubMSceneIDOrSubMScene":                       { "$ref": "#/$defs/SubMSceneIDOrSubMScene" } } } },

    "BasicAudioVisualSceneOrAudioVisualScene":{ "$ref": "#/$defs/BasicAudioVisualSceneOrAudioVisualScene" },

    "DataXMData":                             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                          { "type": "string", "maxLength": 2048 } },

  "$defs":                                    {

    "GeometryObject":                         { "type": "object", "required": [ "ObjectSpaceTime", "ObjectQualifier" ],
                                                "additionalProperties": false, "properties": {
      "ObjectSpaceTime":                      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "ObjectQualifier":                      { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/AudioVisualQualifier.json" } } },

    "ObjectIDOrGeometry":                     { "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                                { "$ref": "#/$defs/GeometryObject" },
                                                { "type": "string" } ] } },

    "SubMSceneIDOrSubMScene":                             { "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                                { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/AudioVisualSceneGeometry.json" },
                                                { "type": "string" } ] } },

    "BasicAudioVisualSceneOrAudioVisualScene":            { "type": "array", "items": { "oneOf": [
                                                { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/BasicAudioVisualSceneGeometry.json" },
                                                { "$ref": "#/$defs/BasicAudioVisualSceneOrAudioVisualScene" } ] } } } }