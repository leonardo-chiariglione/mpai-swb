{ "$schema":                                        "https://json-schema.org/draft/2020-12/schema",
  "$id":                                            "https://schemas.mpai.community/OSD/V1.5/data/OfflineMapSceneGeometry.json",
  "title":                                          "OfflineMapScene Geometry V1.5",
  "description":                                    "Includes Objs, BScene geom.-Scene geom.",
  "type":                                           "object",
  "required":                                       [ "Header", "OfflineMapSceneGeometryID", "OfflineMapSceneGeometrySpaceTime" ],
  "additionalProperties":                           false,
  "properties":                                     {

    "Header":                                       { "type": "string", "const": "OSD-OSG-V1.5" },
    "MInstanceID":                                  { "type": "string" },
    "UEnvironmentID":                               { "type": "string" },
    "OfflineMapSceneGeometryID":                    { "type": "string" },
    "OfflineMapSceneGeometrySpaceTime":             { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },

    "ObjectCount":                                  { "type": "integer", "minimum": 0 },
    "Objects":                                      { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "properties":                                 {
        "ObjectSpaceTime":                          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
        "ObjectIDOrGeometry":                       { "$ref": "#/$defs/ObjectIDOrGeometry" } } } },

    "SubOfflineMapSceneCount":                      { "type": "integer", "minimum": 0 },
    "SubOfflineMapScenes":                          { "type": "array", "items": { "type": "object", "additionalProperties": false,
                                                      "properties": {
        "SubOfflineMapSceneSpaceTime":              { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
        "SubOSceneIDOrSubOScene":                   { "$ref": "#/$defs/SubOSceneIDOrSubOScene" } } } },

    "BasicOfflineMapSceneOrOfflineMapScene":        { "$ref": "#/$defs/BasicOfflineMapSceneOrOfflineMapScene" },

    "DataXMData":                                   { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                                { "type": "string", "maxLength": 2048 } },

  "$defs":                                          {

    "GeometryObject":                               { "type": "object", "required": [ "ObjectSpaceTime", "ObjectQualifier" ],
                                                      "additionalProperties": false, "properties": {
      "ObjectSpaceTime":                            { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "ObjectQualifier":                            { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/OfflineMapQualifier.json" } } },

    "ObjectIDOrGeometry":                           { "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                                      { "$ref": "#/$defs/GeometryObject" },
                                                      { "type": "string" } ] } },

    "SubOSceneIDOrSubOScene":                       { "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                                      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/OfflineMapSceneGeometry.json" },
                                                      { "type": "string" } ] } },

    "BasicOfflineMapSceneOrOfflineMapScene":        { "type": "array", "items": { "oneOf": [
                                                      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/BasicOfflineMapSceneGeometry.json" },
                                                      { "$ref": "#/$defs/BasicOfflineMapSceneOrOfflineMapScene" } ] } } } }