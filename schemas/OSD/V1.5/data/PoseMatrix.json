{ "$schema":          "https://json-schema.org/draft/2020-12/schema",
  "$id":              "https://schemas.mpai.community/OSD/V1.5/data/PoseMatrix.json",
  "title":            "Pose Matrix Object V1.5",
  "type":             "object",
  "required":         ["Matrix"],
  "description":      "Encodes object position, orientation, and scale in homogeneous matrix form",
  "properties":       {

    "Header":         { "type": "string", "const": "OSD-PMX-V1.5" },
    "MInstanceID":    { "type": "string", "description": "Identifier of the M-Instance (Virtual Space) this Pose matrix refers to." },
    "UEnvironmentID": { "type": "string", "description": "Identifier of the U-Environment (Real Space) this Pose matrix refers to." },
    "PoseMareixID":   { "type": "string", "description": "Unique identifier of this Pose Matric instance." },
    "PoseMareixTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json", "description": "Time this Pose Matrix was produced." },

    "PoseMatrixData": { "description": "transformation matrix in row-major order", "type": "array", "items": { "type": "number" }, "minItems": 16, "maxItems": 16 },
    "ReferenceFrame": { "description": "Name of coordinate system (e.g., 'UserView', 'World', 'Camera')", "type": "string" },
    "Precision":      { "description": "Numeric precision of matrix values", "type": "string", "enum": ["float32", "float64"] },

    "DataXMData":     { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":  { "type": "string", "maxLength": 2048 } } }
