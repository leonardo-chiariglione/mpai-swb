{ "$id":                                      "https://schemas.mpai.community/OSD/V1.5/data/AudioVisualEventDescriptors.json",
  "$schema":                                  "https://json-schema.org/draft/2020-12/schema",
  "title":                                    "AudioVisualEvent Descriptors V1.5",
  "description":                              "AudioVisualEvent descriptor set.",
  "type":                                     "object",
  "required":                                 [ "Header", "AudioVisualEventDescriptorsID", "AudioVisualEventDescriptorsSpaceTime", "Trace" ],
  "additionalProperties":                     false,
  "properties":                               {

    "Header":                                 { "type": "string", "const": "OSD-MEV-V1.5" },
    "MInstanceID":                            { "type": "string" },
    "UEnvironmentID":                         { "type": "string" },
    "AudioVisualEventDescriptorsID":          { "type": "string" },
    "AudioVisualEventDescriptorsSpaceTime":   { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },

    "AudioVisualEventDescriptors":            { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": {
      "MSceneIDOrMScene":                     { "description": "Embedded Event Descriptors (recursive) or an Event ID (by reference).",
                                                "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                              { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/AudioVisualSceneDescriptors.json" },
                                              { "type": "string" } ] } } } } },

    "DataXMData":                             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                          { "type": "string", "maxLength": 2048 } } }