{ "$schema":                                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                                      "https://schemas.mpai.community/OSD/V1.5/data/BasicOfflineMapSceneGeometry.json",
  "title":                                    "Basic 3D Model Scene Geometry V1.5",
  "type":                                     "object",
  "additionalProperties":                     false,
  "required":                                 [ "Header", "BasicOfflineMapSceneGeometryID", "BasicOfflineMapSceneGeometrySpaceTime",
                                                "OfflineMapObjectCount",  "OfflineMapObjects" ], "properties": {

    "Header":                                 { "type": "string", "const": "OSD-BOG-V1.5" },
    "MInstanceID":                            { "type": "string" },
    "BasicOfflineMapSceneGeometryID":         { "type": "string" },
    "BasicOfflineMapSceneGeometryTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "BasicOfflineMapSceneGeometrySpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },

    "OfflineMapObjectCount":                  { "type": "integer", "minimum": 0 },

    "OfflineMapObjects":                      { "type": "array", "minItems": 0, "items": { "type": "object", "additionalProperties": false,
                                                "required": [ "OfflineMapObjectSpaceTime", "OfflineMapObjectQualifier" ], "properties": {
      "OfflineMapObjectSpaceTime":            { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "OfflineMapObjectQualifier":            { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/OfflineMapQualifier.json" } } } },

    "DataXMData":                             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                          { "type": "string", "maxLength": 2048 } } }