{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$id":                  "https://schemas.mpai.community/OSD/V1.5/data/TemporalCue.json",
  "title":                "Temporal Cue V1.5",
  "description":          "Represents a time-related signal aligned with SimpleTime",
  "type":                 "object",
  "additionalProperties": false,
  "required":             ["CueType"],
  "properties":           {

    "Header":             { "type": "string", "const": "OSD-TMC-V1.5" },
    "MInstanceID":        { "type": "string" },
    "EnvironmentID":      { "type": "string" },
    "TemporalCueID":      { "type": "string" },
    "TemporalCueTime":    { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "CueType":            { "description": "Nature of the temporal cue", "type": "string", "enum": ["absolute", "relative", "keyword", "range"] },

    "SimpleTimeRef":      { "description": "Reference to SimpleTime structure for absolute or range cues", "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "RelativeExpression": { "type": "string", "pattern": "^(\\+\\d+[smhd]|in \\d+ (seconds|minutes|hours|days))$",
                            "description": "Relative time (e.g., '+2h', 'in 3 days')" },

    "Keyword":            { "type": "string", "enum": ["morning", "afternoon", "evening", "night", "immediate", "scheduled"], "description": "Keyword-based cue" },

    "Confidence":         { "description": "Confidence in temp cue interpret. ", "type": "number", "minimum": 0, "maximum": 1 },

    "DataXMData":         { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":      { "type": "string", "maxLength": 2048 } },

  "oneOf": [
                          { "required": ["SimpleTimeRef"],     "properties": { "CueType": { "const": "absolute" } } },
                          { "required": ["RelativeExpression"], "properties": { "CueType": { "const": "relative" } } },
                          { "required": ["Keyword"],           "properties": { "CueType": { "const": "keyword" } } },
                          { "required": ["SimpleTimeRef"],     "properties": { "CueType": { "const": "range" } } } ] }