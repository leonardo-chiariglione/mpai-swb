{ "$schema":                            "https://json-schema.org/draft/2020-12/schema",
  "$id":                                "https://schemas.mpai.community/OSD/V1.5/data/BasicAudioSceneGeometry.json",
  "title":                              "Basic Audio Scene Geometry V1.5",
  "type":                               "object",
  "additionalProperties":               false,
  "required":                           [ "Header", "BasicAudioSceneGeometryID", "BasicAudioSceneGeometrySpaceTime", "AudioObjectCount", "AudioObjects" ],
  "properties":                         {

    "Header":                           { "type": "string", "const": "OSD-BAG-V1.5" },
    "MInstanceID":                      { "type": "string" },
    "UEnvironmentID":                   { "type": "string" },
    "BasicAudioSceneGeometryID":        { "type": "string" },
    "BasicAudioSceneGeometryTime":      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "BasicAudioSceneGeometrySpaceTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },

    "AudioObjectCount":                 { "type": "integer", "minimum": 0 },
    "AudioObjects":                     { "type": "array", "minItems": 0, "items": { "type": "object", "additionalProperties": false, "required": [ "AudioObjectSpaceTime", "AudioObjectQualifier" ], "properties": {
      "AudioObjectSpaceTime":           { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "AudioObjectQualifier":           { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/AudioQualifier.json" } } } },

    "DataXMData":                       { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                    { "type": "string", "maxLength": 2048 } } }