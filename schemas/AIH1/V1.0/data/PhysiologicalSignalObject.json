{ "$schema":                        "https://json-schema.org/draft/2020-12/schema",
  "$id":                            "https://schemas.mpai.community/AIH/HSP/V1.0/data-types/PhysiologicalSignalObject.json",
  "title":                          "Physiological Signal Object",
  "type":                           "object",
  "required":                       [ "Header", "PhysiologicalSignalObjectID", "EndUserID", "PhysiologicalSignalObjectTime",
                                    "PhysiologicalSignalData", "PhysiologicalSignalQualifier" ],
  "properties":                     {

    "Header":                       { "type": "string", "const": "AIH-PSO-V1.0" },
    "MInstance":                    { "type": "string" },
    "PhysiologicalSignalObjectID":  { "type": "string", "description": "Identifier of the Physiological Signal Object." },
    "EndUserID":                    { "type": "string", "description": "ID of End User the PS Data refers to." },
    "PhysiologicalSignalObjectTime":{ "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "PhysiologicalSignalData":      { "type": "array", "items": { "anyOf": [
                                    { "type": "object", "properties": { "Data": { "type": "string" } } },
                                    { "type": "object", "properties": { "DataLength": { "type": "integer" },
                                                                        "DataURI": { "type": "string", "format": "uri" } } },
                                    { "type": "object", "properties": { "ID": { "type": "string" } } } ] } },

    "PhysiologicalSignalQualifier": { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/PhysiologicalSignalQualifier.json",
                                      "description": "Physiological Signal Qualifier." },

    "DataXMData":                   { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                { "type": "string", "maxLength": 2048 } } }
