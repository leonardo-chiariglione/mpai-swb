{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$comment":             "https://schemas.mpai.community/AIF/V3.0/data/AIMMetadata.json",
  "$id":                  "https://schemas.mpai.community/CAE3/V1.0/AIMs/AudioSceneEditing.json",
  "title":                "Audio Scene Editing V1.0",

  "Identifier":           {"ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "CAE-ASE-V1.0"},

  "APIProfile":           "Basic",
  "Description":          "This AIM composes Audio Objects into an Audio Scene, places them, and sets the listener's Point of View. One Scene is open at a time, so a User Command need not name it. The Object Port accepts a Basic Audio Object or a full one, and the Scene Ports accept Basic Audio Scene Descriptors or full ones; the Header of what arrives says which it is. An Object placed in a Scene keeps its own attributes unless the Scene provides them, in which case the Scene overrides - which is why an Object may carry a listener's Point of View of its own and a Scene's still wins.",

  "InternalTypes":        [],

  "ExternalPorts":        [{"Name": "UserCommand",           "Direction": "Input",  "DataType": "CAE-UCM-V1.0",                    "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "ListenerPointOfView",   "Direction": "Input",  "DataType": "OSD-OPV-V1.5",                    "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "AudioObject",           "Direction": "Input",  "DataType": ["OSD-BAO-V1.5", "OSD-AUO-V1.5"], "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "AudioScene",            "Direction": "Input",  "DataType": ["OSD-BAS-V1.5", "OSD-ASD-V1.5"], "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "AudioSceneDescriptors", "Direction": "Output", "DataType": ["OSD-BAS-V1.5", "OSD-ASD-V1.5"], "Technology": "Software", "Protocol": "", "IsRemote": false}],

  "SubAIMs":              [],
  "Topology":             [],

  "Implementations":      [{"ImplementationURI": "/* URI storing Implementation */",
