{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$comment":             "https://schemas.mpai.community/AIF/V3.0/data/AIMMetadata.json",
  "$id":                  "https://schemas.mpai.community/CAE3/V1.0/AIMs/AudioObjectEditing.json",
  "title":                "Audio Object Editing V1.0",

  "Identifier":           {"ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "CAE-AOE-V1.0"},

  "APIProfile":           "Basic",
  "Description":          "This AIM edits an Audio Object and composes Audio Objects into one. One Object is open at a time, so a User Command need not name its target: it acts on what is open. The Object Port accepts a Basic Audio Object or a full Audio Object and the AIM knows which it was given from the value's Header - an Object holding one Object is Basic, an Object holding more than one is full, so the kind is a fact about the content rather than a declaration about the channel. Composing a Basic Audio Object with another Object produces a full Audio Object; removing all but one produces a Basic Audio Object again.",

  "InternalTypes":        [],

  "ExternalPorts":        [{"Name": "UserCommand", "Direction": "Input",  "DataType": "CAE-UCM-V1.0",                      "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "AudioObject", "Direction": "Input",  "DataType": ["OSD-BAO-V1.5", "OSD-AUO-V1.5"],   "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "AudioObject", "Direction": "Output", "DataType": ["OSD-BAO-V1.5", "OSD-AUO-V1.5"],   "Technology": "Software", "Protocol": "", "IsRemote": false}],

