{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$comment":             "https://schemas.mpai.community/AIF/V3.0/data/AIMMetadata.json",
  "$id":                  "https://schemas.mpai.community/CAE3/V1.0/AIMs/AudioObjectDelivery.json",
  "title":                "Audio Object Delivery V1.0",

  "Identifier":           {"ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "CAE-AOD-V1.0"},

  "APIProfile":           "Basic",
  "Description":          "This AIM delivers an Audio Object to a destination - loudspeaker, headset, network or disk. The input Port accepts a Basic Audio Object or a full one, because either may be delivered: a full Object is rendered from the Objects it holds. The output Port is Hardware and its consumer is the LISTENER rather than the User Agent, which is what distinguishes delivery from the Descriptors an editing AIM returns for a display to be redrawn.",

  "InternalTypes":        [],

  "ExternalPorts":        [{"Name": "UserCommand", "Direction": "Input",  "DataType": "CAE-UCM-V1.0",                    "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "InputAudio",  "Direction": "Input",  "DataType": ["OSD-BAO-V1.5", "OSD-AUO-V1.5"], "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "OutputAudio", "Direction": "Output", "DataType": "OSD-BAO-V1.5",                    "Technology": "Hardware", "Protocol": "", "IsRemote": false}],

  "SubAIMs":              [],
  "Topology":             [],

  "Implementations":      [{"ImplementationURI": "/* URI storing Implementation */",
                            "BinaryName":       "/* BinaryName */",
                            "Architecture":     "/* x86 | x86-64 | ARM | ARM64 | MIPS | RISC-V */",
                            "OperatingSystem":  "/* Windows | Linux | MacOS | Debian | Ubuntu | RedHat | Android | Zephyr | RTOS | Oniro | iOS */",
                            "Version":          "/* Version */",
                            "Source":           "/* AIMStorage | MPAIStore | AIMURL */",
                            "Destination":      "/* Destination URI */"}],

  "ResourcePolicies":     [{"Name": "Memory",    "Minimum": "/* GB */",                  "Request": "/* GB */",                  "Maximum": "/* GB */"},
                           {"Name": "CPU:Class", "Minimum": "/* Low | Medium | High */", "Request": "/* Low | Medium | High */", "Maximum": "/* Low | Medium | High */"}],

  "DataXMData":           { },

