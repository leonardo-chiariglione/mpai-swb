{ "$id":                    "https://schemas.mpai.community/TFA/V1.5/data/GestureDescriptorsQualifier.json",
  "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "title":                  "Gesture Descriptors Qualifier V1.5",
  "description":            "Qualifier describing subtypes, format, and attributes of gesture descriptors.",
  "type":                   "object",
  "required":               [ "Header", "GestureDescriptorsQualifierID", "SubTypes", "Formats" ],
  "additionalProperties":   false,
  "properties":             {

    "Header":               { "type": "string", "const": "TFA-GDQ-V1.5" },
    "MInstanceID":          { "type": "string" },
    "UEnvironmentID":       { "type": "string" },
    "GestureDescriptorsQualifierID":    { "type": "string" },
    "GestureDescriptorsQualifierTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SubTypes":              { "type": "object", "additionalProperties": false },

    "Formats":               { "type": "object", "additionalProperties": false, "properties": {
      "ContentFormat":      { "$ref": "https://schemas.mpai.community/TFA/V1.5/formats/BodyDescriptorsContentFormats.json" } } },

    "Attributes":           { "type": "object", "additionalProperties": false },

    "DataXMData":           { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } } }
