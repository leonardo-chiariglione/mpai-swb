{ "$id":                          "https://schemas.mpai.community/TFA/V1.5/data/DiscoveryQualifier.json",
  "$schema":                      "https://json-schema.org/draft/2020-12/schema",
  "title":                        "Discovery Qualifier V1.5",
  "description":                  "Categories, formats and metadata for discovery content.",
  "type":                         "object",
  "required":                     [ "Header", "DiscoveryQualifierID", "Formats" ],
  "additionalProperties":         false,
  "properties":                   {

    "Header":                     { "type": "string", "const": "TFA-DVQ-V1.5" },
    "MInstanceID":                { "type": "string" },
    "UEnvironmentID":             { "type": "string" },
    "DiscoveryQualifierID":       { "type": "string" },
    "DiscoveryQualifierTime":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "Formats":                     { "type": "object", "additionalProperties": false, "properties": {
      "MPAIContentFormat":        { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/BasicDiscovery.json" },
      "OtherContentFormats":      { "$ref": "https://schemas.mpai.community/TFA/V1.5/formats/DiscoveryFormats.json" } } },

    "DataXMData":     { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":  { "type": "string", "maxLength": 2048 } } }
