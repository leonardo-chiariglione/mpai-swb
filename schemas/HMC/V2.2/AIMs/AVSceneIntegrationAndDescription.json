{ "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "https://schemas.mpai.community/AIF/V3.0/data/AIMMetadata.json",
  "$id": "https://schemas.mpai.community/HMC/V2.2/AIMs/AVSceneIntegrationAndDescription.json",
  "title": "AV Scene Integration and Description V2.2",

  "Identifier":   { "ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "HMC-SID-V2.2" },

  "APIProfile":   "Secure",
  "Description":  "This AIM adds the Avatar in the Input Portable Avatar to the Audio-Visual Scene and produces the resulting Audio-Visual Scene Descriptors.",

  "ExternalPorts":  [
    { "Name": "PortableAvatar"    , "Direction": "Input",   "DataType": "PAF-PAF-V1.6",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "AVSceneDescriptors", "Direction": "Output",  "DataType": "OSD-MSD-V1.5",  "Technology": "Software", "Protocol": "", "IsRemote": false }
  ],

  "SubAIMs":  [ ],
  "Topology":  [ ],

  "Implementations":  [
   {
    "BinaryName": "/* provided by implementer */",
    "Architecture": "/* x86-64 | ARM64 */",
    "OperatingSystem": "/* Windows | Linux | MacOS */",
    "Version": "/* implementer version */",
    "Source": "/* AIMStorage | MPAIStore */",
    "Destination": "/* provided by implementer */"
   }
  ],

  "ResourcePolicies":  [
    { "Name": "Memory"              , "Minimum": "/* GB */",             "Maximum": "/* GB */",             "Request": "/* GB */" },
    { "Name": "CPU:Number"          , "Minimum": "/* integer, 0=all */", "Maximum": "/* integer, 0=all */", "Request": "/* integer */" },
    { "Name": "CPU:Class"           , "Minimum": "/* string */",         "Maximum": "/* string */",         "Request": "/* string */" },
    { "Name": "GPU:Number"          , "Minimum": "/* integer, 0=all */", "Maximum": "/* integer, 0=all */", "Request": "/* integer */" },
    { "Name": "GPU:CUDA:Class"      , "Minimum": "/* string */",         "Maximum": "/* string */",         "Request": "/* string */" },
    { "Name": "GPU:CUDA:FrameBuffer", "Minimum": "/* GB */",             "Maximum": "/* GB */",             "Request": "/* GB */" },
    { "Name": "GPU:CUDA:MemorySpeed", "Minimum": "/* GB/s */",           "Maximum": "/* GB/s */",           "Request": "/* GB/s */" }
  ],

  "DataXMData":  { },

  "Documentation":  [{ "Type": "Tutorial", "URI": "https://mpai.community/standards/mpai-hmc/v2-1/" }] }