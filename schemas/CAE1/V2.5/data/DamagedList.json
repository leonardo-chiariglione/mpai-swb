{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/CAE1/V2.5/data/DamagedList.json",
  "title":                  "DamagedList V2.5",
  "type":                   "object",
  "required":               ["Header", "DamagedListData"],
  "additionalProperties":   false,
  "properties":             {

    "Header":               { "type": "string", "const": "CAE-DLS-V1.5" },
    "MInstanceID":          { "type": "string" },
    "UEnvironmentID":       { "type": "string" },
    "DamagedListID":        { "type": "string" },
    "DamagedListTime":      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "DamagedListData":      { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["DamagedSectionTime"],
                              "additionalProperties": false, "properties": {
      "DamagedSectionTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" } } } },

    "DataXMData":           {"$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } } }
