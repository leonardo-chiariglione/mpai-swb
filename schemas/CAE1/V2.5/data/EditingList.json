{ "$schema":                        "https://json-schema.org/draft/2020-12/schema",
  "$id":                            "https://schemas.mpai.community/CAE1/V2.5/data/EditingList.json",
  "title":                          "Editing List V2.5",
  "type":                           "object",
  "required":                       [ "Restorations", "OriginalSamplingFrequency", "Header"],
  "additionalProperties":           false,
  "properties":                     {

    "Header":                       { "type": "string", "const": "CAE-ELS-V2.5" },
    "MInstanceID":                  { "type": "string" },
    "UEnvironmentID":               { "type": "string" },
    "EditingListID":                { "type": "string" },
    "EditingListTime":              { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "OriginalSpeedStandard":        { "type": "number", "enum": [0.9375, 1.875, 3.75, 7.5, 15, 30] },

    "OriginalEqualisationStandard": { "type": "string", "enum": ["IEC", "IEC1", "IEC2"] },

    "OriginalSamplingFrequency":    { "type": "integer", "minimum": 1 },

    "Restorations":                 { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object",
                                      "required": ["RestorationID", "RestoredAudioFileURI", "PreservationAudioFileStart",
                                      "PreservationAudioFileEnd", "AppliedSamplingFrequency", "ReadingBackwards"],
                                      "additionalProperties": false, "properties": {
      "RestorationID":              { "type": "string", "format": "uuid" },
      "PreservationAudioFileStart": { "type": "string", "pattern": "[0-9],{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9],{3}" },
      "PreservationAudioFileEnd":   { "type": "string", "pattern": "[0-9],{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9],{3}" },
      "RestoredAudioFileURI":       { "type": "string", "format": "uri" },
      "ReadingBackwards":           { "type": "boolean" },
      "AppliedSpeedStandard":       { "type": "number", "enum": [0.9375, 1.875, 3.75, 7.5, 15, 30] },
      "AppliedSamplingFrequency":   { "type": "integer" },
      "AppliedEqualisationStandard":{ "type": "string", "enum": ["IEC", "IEC1", "IEC2"] } }} },

    "DataXMData":                   {"$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                { "type": "string", "maxLength": 2048 } } }
