{
    "$schema":  "http://json-schema.org/draft/2019-09/schema",
    "title":  "AIMProfiles",
    "type":  "object",
    "properties":  {
                       "Header":  {
                                      "type":  "string",
                                      "pattern":  "^PRF-[0-9],{1,2},[.][0-9],{1,2}$"
                                  },
                       "Profile":  {
                                       "type":  "string",
                                       "pattern":  "^(ALL|NUL)([+-](AUO|AVG|AVM|BDO|BDD|FCI|FCO|FCD|IPS|LGP|MEM|SPM|OII|POV|PAV|SPD|SPI|SPO|TXD|TXO|TXR|TRN|VIO)|@IPS(#(TXT|SPE|FCE|GST))+|@TRN(#([a-z],{3})(\u003c-\u003e|-\u003e)([a-z],{3}))+)+$"
                                   }
                   },
    "$id":  "https://schemas.mpai.community/PRF/V1.0/data/AIMProfiles.json"
}

