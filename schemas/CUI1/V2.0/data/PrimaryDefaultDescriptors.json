{ "$schema":                              "https://json-schema.org/draft/2020-12/schema",
  "$id":                                  "https://schemas.mpai.community/CUI1/V2.0/data/PrimaryDefaultDescriptors.json",
  "title":                                "Primary Default Descriptors V2.0",
  "type":                                 "object",
  "properties":                           {

    "Header":                             { "type": "string", "const": "CUI-PDD-V2.0" },
    "MInstanceID":                        { "type": "string" },
    "UEnvironmentID":                     { "type": "string" },
    "PrimaryDefaultDescriptorsID":        { "type": "string" },
    "PrimaryDefaultDescriptorsTime":      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "PrimaryDefaultDescriptors":          { "type": "array", "items": { "type": "object", "properties": {

      "PrimaryDefaultProbability":        { "type": "number" },

      "PrimaryDefaultDescriptorImpacts":  { "type": "array", "items": { "type": "object", "properties": {

        "PrimaryDefaultDescriptorID":     { "type": "string" },

        "PrimaryDefaultDescriptorImpact": { "type": "number" } } } }  } } },

    "Trace":                              { "$ref": "https://schemas.mpai.community/AIF/V3.0/data/Trace.json" },
    "DescrMetadata":                      { "type": "string" } } }
