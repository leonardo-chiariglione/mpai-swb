  "title": "Company Assessment and Prediction Composite V2.0",

  "Identifier":   { "ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "CUI-CAP-V2.0" },

  "APIProfile":   "Secure",
