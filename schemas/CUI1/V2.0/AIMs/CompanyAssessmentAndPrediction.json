  "ExternalPorts":  [
    { "Name": "PredictionHorizon"              , "Direction": "Input",   "DataType": "number",        "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "ClimateRiskDescriptors"         , "Direction": "Input",   "DataType": "CUI-LRD-V2.0",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "CyberRiskDescriptors"           , "Direction": "Input",   "DataType": "CUI-CRD-V2.0",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "GovernanceDescriptors"          , "Direction": "Input",   "DataType": "CUI-GVS-V2.0",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "FinancialDescriptors"           , "Direction": "Input",   "DataType": "CUI-FND-V2.0",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "PrimaryDefaultDescriptors"      , "Direction": "Output",  "DataType": "CUI-PDD-V2.0",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "OrganisationDescriptors"        , "Direction": "Output",  "DataType": "CUI-ORD-V2.0",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "PrimaryDiscontinuityDescriptors", "Direction": "Output",  "DataType": "CUI-PSD-V2.0",  "Technology": "Software", "Protocol": "", "IsRemote": false }
  ],

  "SubAIMs":  [
    { "Identifier": { "ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "CUI-CDP-V2.0" } },
    { "Identifier": { "ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "CUI-OMA-V2.0" } },
    { "Identifier": { "ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "CUI-PDP-V2.0" } }
  ],

  "Topology":  [
    { "Output": { "AIMName": ""            , "PortName": "PredictionHorizon"               }, "Input": { "AIMName": "CUI-CDP-V2.0", "PortName": "PredictionHorizon" } },
    { "Output": { "AIMName": ""            , "PortName": "FinancialDescriptors"            }, "Input": { "AIMName": "CUI-CDP-V2.0", "PortName": "FinancialDescriptors" } },
    { "Output": { "AIMName": ""            , "PortName": "PredictionHorizon"               }, "Input": { "AIMName": "CUI-OMA-V2.0", "PortName": "PredictionHorizon" } },
    { "Output": { "AIMName": ""            , "PortName": "GovernanceDescriptors"           }, "Input": { "AIMName": "CUI-OMA-V2.0", "PortName": "GovernanceDescriptors" } },
    { "Output": { "AIMName": ""            , "PortName": "FinancialDescriptors"            }, "Input": { "AIMName": "CUI-OMA-V2.0", "PortName": "FinancialDescriptors" } },
    { "Output": { "AIMName": ""            , "PortName": "PredictionHorizon"               }, "Input": { "AIMName": "CUI-PDP-V2.0", "PortName": "PredictionHorizon" } },
    { "Output": { "AIMName": ""            , "PortName": "ClimateRiskDescriptors"          }, "Input": { "AIMName": "CUI-PDP-V2.0", "PortName": "ClimateRiskDescriptors" } },
    { "Output": { "AIMName": ""            , "PortName": "CyberRiskDescriptors"            }, "Input": { "AIMName": "CUI-PDP-V2.0", "PortName": "CyberRiskDescriptors" } },
    { "Output": { "AIMName": ""            , "PortName": "GovernanceDescriptors"           }, "Input": { "AIMName": "CUI-PDP-V2.0", "PortName": "GovernanceDescriptors" } },
    { "Output": { "AIMName": ""            , "PortName": "FinancialDescriptors"            }, "Input": { "AIMName": "CUI-PDP-V2.0", "PortName": "FinancialDescriptors" } },
    { "Output": { "AIMName": "CUI-CDP-V2.0", "PortName": "PrimaryDefaultDescriptors"       }, "Input": { "AIMName": ""            , "PortName": "PrimaryDefaultDescriptors" } },
    { "Output": { "AIMName": "CUI-OMA-V2.0", "PortName": "OrganisationDescriptors"         }, "Input": { "AIMName": ""            , "PortName": "OrganisationDescriptors" } },
    { "Output": { "AIMName": "CUI-PDP-V2.0", "PortName": "PrimaryDiscontinuityDescriptors" }, "Input": { "AIMName": ""            , "PortName": "PrimaryDiscontinuityDescriptors" } }
  ],

  "Implementations":  [
