{ "$id":                        "https://schemas.mpai.community/XRV1/V1.0/data/VEVenueSpecification.json",
  "$schema":                    "https://json-schema.org/draft/2020-12/schema",
  "title":                      "VE Venue Specification V1.0", 
  "description":                "Specification of a VE Venue.",
  "type":                       "object", 
  "required":                   [ "Header" ], 
  "additionalProperties":       false, 
  "properties": {

    "Header":                   { "type": "string", "const": "XRV-VVS-V1.0" },
    "MInstanceID":              { "type": "string" },
    "UEnvironmentID":           { "type": "string" },
    "VEVenueSpecificationID":   { "type": "string" },
    "VEVenueSpecificationTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "MetaverseAPI":             { "$ref": "https://schemas.mpai.community/TFA/V1.5/formats/MetaverseAPIFormats.json" },

    "VEVenueSpecificationModel":{ "$ref": "https://schemas.mpai.community/OSD/V1.5/data/3DModelSceneDescriptors.json" },

    "VirtualObjects":           { "type": "array", "items": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/3DModelObject.json" } },

    "Dataxmdata":               { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":            { "type": "string", "maxLength": 2048 } } }
