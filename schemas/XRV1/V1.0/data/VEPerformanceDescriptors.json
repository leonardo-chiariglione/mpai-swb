{ "$schema":                      "https://json-schema.org/draft/2020-12/schema",
  "$id":                          "https://schemas.mpai.community/XRV1/V1.0/data/VEPerformanceDescriptors.json",
  "title":                        "VEPerformanceDescriptors",
  "description":                  "Descriptor set for Virtual Environment (VE) performance: scene, performers, objects, camera, and timing.",
  "type":                         "object",
  "additionalProperties":         false,
  "required":                     [ "Header", "VEPerformanceDescriptorsID", "VEPerformerDescriptors" ],
  "properties":                   {

    "Header":                     { "type": "string", "const": "XRV-VFD-V1.0" },
    "MInstanceID":                { "type": "string" },
    "UEnvironmentID":             { "type": "string" },
    "VEPerformanceDescriptorsID": { "type": "string" },
    "VEPerformanceTime":          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },
    "AVSceneDescriptors":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },

    "VEPerformerDescriptors":     { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": [ "VEPerformerID" ], "properties": {

        "VEPerformerID":          { "type": "string" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
        "Avatar":                 { "$ref": "https://schemas.mpai.community/PAF/V1.6/data/Avatar.json" },
        "SpeechObject":           { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpeechObject.json" } } } },

      "BiometricData":              { "$ref": "https://schemas.mpai.community/AIH1/V1.0/data/BiometricData.json" },
      "Brainwavefreq":              { "type": "object", "additionalProperties": false, "properties": {
        "alpha":                    { "type": "number" },
        "theta":                    { "type": "number" },
        "delta":                    { "type": "number" },
        "beta":                     { "type": "number" },
        "gamma":                    { "type": "number" } } },
      "ControllerData":             { "type": "string" },

    "VEObjectDescriptors":        { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": [ "VEObjectID", "VEObject" ], "properties": {

        "VEObjectID":             { "type": "string" },
        "VEObject":               { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/3DModelObject.json" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" } } } },

    "VCameraData":                { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": {

        "VEVisualObject":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/3DModelObject.json" },
        "FieldOfView":            { "type": "number", "minimum": 0, "maximum": 180 },
        "VEAudioObject":          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/3DModelObject.json" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" } } } },

    "DataXMdata":                 { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":              { "type": "string", "maxLength": 2048 } } }
