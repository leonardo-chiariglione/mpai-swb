{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json",
  "title":                    "Control Object V1.0",
  "type":                     "object",
  "additionalProperties":     false,
  "required":                 [ "Header", "ControllerID", "ControllerSpaceTime", "ControlObjectID", "ControlData", "ControlQualifier" ],
  "properties":               {

    "Header":                { "type": "string", "const": "XRV-CTO-V1.0" },
    "MInstanceID":           { "type": "string" },
    "UEnvironmentID":        { "type": "string" },
    "ControlObjectID":       { "type": "string" },
    "ControlObjectTime":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "ControllerSpaceTime":   { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },

    "ControlData":           { "type": "string" },

    "ControlQualifier":      { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/ControlQualifier.json" },

    "DataXMData":            { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":         { "type": "string" } } }