{ "$schema":                        "https://json-schema.org/draft/2020-12/schema",
  "$id":                            "https://schemas.mpai.community/XRV1/V1.0/data/REPerformanceDescriptors.json",
  "title":                          "RE Performance Descriptors V1.0",
  "type":                           "object",
  "additionalProperties":           false,
  "required":                       ["Header", "REPerformanceDescriptorsID", "REPerformanceDescriptorsData"],
  "properties":                     {

    "Header":                       { "type": "string", "const": "XRV-RFD-V1.0" },
    "MInstanceID":                  { "type": "string" },
    "UEnvironmentID":               { "type": "string" },
    "REPerformanceDescriptorsID":   { "type": "string" },
    "REPerformanceDescriptorsTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "AVSceneDescriptors":           { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },

    "REPerformanceDescriptorsData": { "type": "array", "minItems": 0, "items": { "type": "object", "required": ["REPerformerID"], "additionalProperties": false, "properties": {
      "REPerformerID":              { "type": "string" },
      "FaceDescriptorsObject":      { "$ref": "https://schemas.mpai.community/PAF/V1.6/data/FaceDescriptorsObject.json" },
      "BodyDescriptorsObject":      { "$ref": "https://schemas.mpai.community/PAF/V1.6/data/BodyDescriptorsObject.json" },
      "SpatialAttitude":            { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
      "UtteredSpeech":              { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpeechObject.json" },
      "BiometricData":              { "$ref": "https://schemas.mpai.community/AIH1/V1.0/data/BiometricData.json" },
      "Brainwavefreq":              { "type": "object", "additionalProperties": false, "properties": {
        "alpha":                    { "type": "number" },
        "theta":                    { "type": "number" },
        "delta":                    { "type": "number" },
        "beta":                     { "type": "number" },
        "gamma":                    { "type": "number" } } },
      "ControllerData":             { "type": "string" } } } },

    "REObjectDescriptors":          { "type": "array", "minItems": 0, "items": { "type": "object", "required": ["REObjectID"], "additionalProperties": false, "properties": {
      "REObjectID":                 { "type": "string" },
      "SpatialAttitude":            { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
      "ControlObject":              { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json" } } } },

    "DataXMData":                   { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                { "type": "string", "maxLength": 2048 } } }