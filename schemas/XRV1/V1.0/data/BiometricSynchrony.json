{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/XRV1/V1.0/data/BiometricSynchrony.json",
  "title":                  "Biometric Synchrony V1.0",
  "type":                   "object", 
  "additionalProperties":   false, 
  "required":               [ "Header" ],
  "properties":             {

    "Header":               { "type": "string", "const": "XRV-BMS-V1.0" },
    "MInstanceID":          { "type": "string" },
    "UEnvironmentID":       { "type": "string" },
    "BiometricSynchronyID": { "type": "string" },
    "BiometricSynchronyTime":   { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "BiometricSynchronyData":        { "type": "object", "additionalProperties": false, "properties": {

      "BrainSynchrony":    { "type": "number" },
      "HeartSynchrony":    { "type": "number" } } },

    "Dataxmdata":           { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } } }
