{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/MMM4/V2.2/actions/UMSendPA.json",
  "title":                  "UM Send PA",
  "type":                   "object",
  "required":               [ "Header", "MInstanceID", "Time", "UMSendPARQ", "UMSendPARS" ],
  "properties":             {

    "Header":               { "type": "string", "pattern": "^USP-1SP-V[0-9],{1,2},[.][0-9],{1,2}$" },
    "MInstanceID":          { "type": "string" },
    "UEnvironmentID":       { "type": "string" },
    "UMSendPAID":           { "type": "string" },
    "UMSendPATime":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "Time":                 { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "UMSendPARQ":           { "type": "object", "properties": {
      "RQ1":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "Nil" },
        "Message":          { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Message.json" } } },
      "RQ2":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "To" },
        "ProcessID":        { "type": "string" } } },
      "RQ3":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "Rights":           { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RQ4":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "SPM":              { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } } } },

    "UMSendPARS":           { "type": "object", "properties": {
      "RS1":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "Rights":           { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RS2":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "PAStatus":         { "type": "array", "items": { "oneOf": [
                            { "type": "object", "properties": {
          "Err":            { "type": "string", "enum": [ "FaultyPA", "IncID", "InsRights", "InsValue" ] } } },
                            { "type": "object", "properties": {
          "Ack":            { "type": "string", "enum": [ "Ack" ] } } } ] } } } } } },

    "DataXMData":         { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":      { "type": "string", "maxLength": 2048 } },

  "oneOf": [              { "required": [ "UMSendPARQ" ], "not": { "required": [ "UMSendPARS" ] } },
                          { "required": [ "UMSendPARS" ], "not": { "required": [ "UMSendPARQ" ] } } ] }
