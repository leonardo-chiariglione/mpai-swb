{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$id":                  "https://schemas.mpai.community/MMM4/V2.2/actions/InterpretPA.json",
  "title":                "InterpretPA",
  "type":                 "object",
  "required":             [ "Header", "Time" ],
  "properties":           {

    "Header":             { "type": "string", "const": "MMM-ITP-V2.2" },
    "MInstanceID":        { "type": "string" },
    "UEnvironmentID":     { "type": "string" },
    "InterpretPAID":      { "type": "string" },
    "InterpretPATime":    { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "Time":               { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "InterpretPARQ":      { "type": "object", "properties": {
      "RQ1":              { "type": "object", "properties": {
        "Complement":     { "type": "string", "const": "With" },
        "Interpretation": { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ItemOrID.json#/$defs/InterpretionOrID" } } },
      "RQ2":              { "type": "object", "properties": {
        "Complement":     { "type": "string", "const": "With" },
        "Rights":         { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RQ3":              { "type": "object", "properties": {
        "Complement":     { "type": "string", "const": "At" },
        "User":           { "type": "string" } } },
      "RQ4":              { "type": "object", "properties": {
        "Complement":     { "type": "string", "const": "With" },
        "SPM":            { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } }  } },

    "InterpretPARS":      { "type": "object", "properties": {

      "RS1":              { "type": "object", "properties": {
        "Complement":     { "type": "string", "const": "With" },
        "Interpretation": { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ItemOrID.json#/$defs/InterpretionOrID" } } },

      "RS2":              { "type": "object", "properties": {
        "Complement":     { "type": "string", "const": "With" },
        "Rights":         { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },

      "RS3":              { "type": "object", "properties": {
        "Complement":     { "type": "string", "const": "With" },
        "PAStatus":       { "type": "array", "items": { "oneOf": [
                          { "type": "object", "properties": {
          "Err":          { "type": "string", "enum": [ "FaultyPA", "IncDQ", "InsRights", "InsValue" ] } } },

                          { "type": "object", "properties": {
          "Ack":          { "type": "string", "enum": [ "Ack" ] } } } ] } } } } } },

    "DataXMData":         { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":      { "type": "string", "maxLength": 2048 } },

  "oneOf": [              { "required": [ "InterpretPARQ" ], "not": { "required": [ "InterpretPARS" ] } },
                          { "required": [ "InterpretPARS" ], "not": { "required": [ "InterpretPARQ" ] } } ] }

