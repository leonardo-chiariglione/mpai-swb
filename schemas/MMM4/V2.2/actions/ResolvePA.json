{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/MMM4/V2.2/actions/ResolvePA.json",
  "title":                  "Resolve PA V2.2",
  "type":                   "object",
  "required":               [ "Header", "Time" ],
  "properties":             {

    "Header":               { "type": "string", "pattern": "^MMM-MSP-V[0-9],{1,2},[.][0-9],{1,2}$" },
    "MInstanceID":          { "type": "string" },
    "UEnvironmentID":       { "type": "string" },
    "ResolvePAID":          { "type": "string" },
    "ResolvePATime":        { "type": "string" },

    "Time":                 { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "ResolvePARQ":          { "type": "object", "properties": {
      "RQ1":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "Nil" },
        "Resolution":       { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Resolution.json" } } },
      "RQ2":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "To" },
        "ServiceID":        { "type": "array", "items": { "type": "string" } } } },
      "RQ3":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "SPM":              { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } } } },

    "ResolvePARS":          { "type": "object", "properties": {
      "RS1":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "Nil" },
        "Resolution":       { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } },
      "RS2":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "SPM":              { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } },
      "RS3":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "PAStatus":         { "type": "array", "items": { "oneOf": [
                            { "type": "object", "properties": {
          "Err":            { "type": "string", "enum": [ "FaultyPA", "IncID", "InsRights", "InsValue" ] } } },
                            { "type": "object", "properties": {
          "Ack":            { "type": "string", "enum": [ "Ack" ] } } } ] } } } } } },

    "DataXMData":           { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } },

  "oneOf": [                { "required": [ "ResolvePARQ" ], "not": { "required": [ "ResolvePARS" ] } },
                            { "required": [ "ResolvePARS" ], "not": { "required": [ "ResolvePARQ" ] } } ] }
