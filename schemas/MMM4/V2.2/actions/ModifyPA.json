{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/MMM4/V2.2/actions/ModifyPA.json",
  "title":                  "ModifyPA",
  "type":                   "object",
  "required":               [ "Header", "MInstanceID", "Time", "ModifyPARQ", "ModifyPARS" ],
  "properties":             {

    "Header":             { "type": "string", "const": "MMM-MOP-V2.2" },
    "MInstanceID":        { "type": "string" },
    "UEnvironmentID":     { "type": "string" },
    "ModifyPAID":         { "type": "string" },
    "ModifyPATime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "Time":               { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "ModifyPARQ":         { "type": "object", "properties": {
      "RQ1":              { "type": "object", "properties": { "Complement": { "type": "string", "const": "Nil" },  "ItemID":    { "type": "string" } } },
      "RQ2":              { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "Data":      { "type": "string" } } },
      "RQ3":              { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "Qualifier": { "type": "string" } } },
      "RQ4":              { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "Rights":    { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RQ5":              { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "SPM":       { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } } } },

    "ModifyPARS":         { "type": "object", "properties": { 
      "RS1":              { "type": "object", "properties": { "Complement": { "type": "string", "const": "Nil" },  "ItemID":    { "type": "string" } } },
      "RS2":              { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "Rights":    { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RS3":              { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "PAStatus":  { "type": "array", "items": { "oneOf": [
                          { "type": "object", "properties": {
        "Err":            { "type": "string", "enum": [ "FaultyPA", "IncID", "IncDQ", "InsRights", "InsValue" ] } } },
                          { "type": "object", "properties": {
        "Ack":            { "type": "string", "enum": [ "Ack" ] } } } ] } } } } } },

    "DataXMData":         { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":      { "type": "string", "maxLength": 2048 } },

  "oneOf": [              { "required": [ "ModifyPARQ" ], "not": { "required": [ "ModifyPARS" ] } },
                          { "required": [ "ModifyPARS" ], "not": { "required": [ "ModifyPARQ" ] } } ] }
