{ "$schema":               "https://json-schema.org/draft/2020-12/schema",
  "$id":                   "https://schemas.mpai.community/MMM4/V2.2/actions/MMAddPA.json",
  "title":                 "MM-Add PA V2.2",
  "type":                  "object",
  "required":              [ "Header", "Time" ],
  "properties":            {

    "Header":              { "type": "string", "const": "MMM-2DP-V2.2" },
    "MInstanceID":         { "type": "string" },
    "UEnvironmentID":      { "type": "string" },
    "MMAddPAID":           { "type": "string" },
    "MMAddPATime":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "Time":                { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/SimpleTime.json" },

    "MMAddPARQ":           { "type": "object", "properties": {
      "RQ1":               { "type": "object", "properties": { "Complement": { "type": "string", "const": "Nil" },  "Item":               { "type": "string" } } },
      "RQ2":               { "type": "object", "properties": { "Complement": { "type": "string", "const": "At" },   "MLocationID":        { "type": "string" } } },
      "RQ3":               { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "SpatialAttitude":    { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" } } },
      "RQ4":               { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "PerceptibilityState":{ "type": "integer", "enum": [ 0, 1 ] } } },
      "RQ5":               { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "Rights":             { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RQ6":               { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "SPM":                { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } } } },

    "MMAddPARS":           { "type": "object", "properties": {
      "RS1":               { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "Rights":   { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RS2":               { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "SPM":      { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } },
      "RS3":               { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "PAStatus": { "type": "array", "items": { "oneOf": [
                           { "type": "object", "properties": { "Err": { "type": "string", "enum": [ "Clash", "FaultyPA", "IncID", "MLocOOR", "InsRights", "InsValue" ] } } },
                           { "type": "object", "properties": { "Ack": { "type": "string", "enum": [ "Ack" ] } } } ] } } } } } },

    "DataXMData":          { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":       { "type": "string", "maxLength": 2048 } },

  "oneOf": [               { "required": [ "MMAddPARQ" ], "not": { "required": [ "MMAddPARS" ] } },
                           { "required": [ "MMAddPARS" ], "not": { "required": [ "MMAddPARQ" ] } } ] }