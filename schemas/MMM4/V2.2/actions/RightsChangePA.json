{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/MMM4/V2.2/actions/RightsChangePA.json",
  "title":                  "Rights Change PA V2.2",
  "type":                   "object",
  "required":               [ "Header", "Time" ],
  "properties":             {

    "Header":               { "type": "string", "const": "MMM-RCP-V2.2" },

    "MInstanceID":          { "type": "string" },
    "UEnvironmentID":       { "type": "string" },
    "RightsChangePAID":     { "type": "string" },
    "RightsChangePATime":   { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "Time":                 { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "RightsChangePARQ":     { "type": "object", "properties": {

      "RQ1":                { "oneOf": [
                            { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "Nil" },
        "ProcessID":        { "type": "string" } } },
                            { "oneOf": [
                            { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "Nil" },
        "ItemID":           { "type": "string" } } },
                            { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "Nil" },
        "MLocationID":      { "type": "string" } } } ] } ] },

      "RQ2":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "NewRights":        { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },

      "RQ3":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "FutureRights":     { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },

      "RQ4":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "SPM":              { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } } } },

    "RightsChangePARS":     { "type": "object", "properties": {

      "RS1":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "Rights":           { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },

      "RS2":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "SPM":              { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } },

      "RS3":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "PAStatus":         { "type": "array", "items": { "oneOf": [
                            { "type": "object", "properties": { "Err": { "type": "string",
                              "enum": [ "FaultyPA", "IncID", "InsRights", "InsValue", "MLocOOR" ] } } },
                            { "type": "object", "properties": { "Ack": { "type": "string",
                              "enum": [ "Ack" ] } } } ] } } } } } },
    "DataXMData":           { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } },

  "oneOf": [                { "required": [ "RightsChangePARQ" ], "not": { "required": [ "RightsChangePARS" ] } },
                            { "required": [ "RightsChangePARS" ], "not": { "required": [ "RightsChangePARQ" ] } } ] }
