{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/MMM4/V2.2/actions/MUActuatePA.json",
  "title":                    "MUActuatePA",
  "type":                     "object",
  "required":                 [ "Header", "Time" ],
  "properties":               {

    "Header":                 { "type": "string", "pattern": "MMM-3CP-V2.2" },
    "MInstanceID":            { "type": "string" },
    "UEnvironmentID":         { "type": "string" },
    "MUActuatePAID":          { "type": "string" },
    "MUActuatePATime":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "Time":                   { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "MUActuatePARQ":          { "type": "object", "properties": {
      "RQ1":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "Nil" },  "ItemID":         { "type": "string" } } },
      "RQ2":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "Nil" },  "MLocation":      { "type": "string" } } },
      "RQ3":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "At" },   "ULocation":      { "type": "string" } } },
      "RQ4":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "RItemType":      { "type": "string" } } },
      "RQ5":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "SpatialAttitude": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" } } },
      "RQ6":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "Rights":         { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RQ7":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "SPM":            { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } } } },

    "MUActuatePARS":          { "type": "object", "properties": {
      "RS1":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "Nil" },  "RItem":  { "type": "string" } } },
      "RS2":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "Rights": { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RS3":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "PAStatus": { "type": "array", "items": { "oneOf": [
                              { "type": "object", "properties": { "Err": { "type": "string", "enum": [ "Clash", "FaultyPA", "IncID", "MLocOOR", "ULocOOR", "InsRights", "InsValue" ] } } },
                              { "type": "object", "properties": { "Ack": { "type": "string", "enum": [ "Ack" ] } } } ] } } } } } },

    "DataXMData":             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":          { "type": "string", "maxLength": 2048 } },

  "oneOf": [                  { "required": [ "MUActuatePARQ" ], "not": { "required": [ "MUActuatePARS" ] } },
                              { "required": [ "MUActuatePARS" ], "not": { "required": [ "MUActuatePARQ" ] } } ] }