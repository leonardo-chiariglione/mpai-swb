{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/MMM4/V2.2/actions/TransactPA.json",
  "title":                    "Transact PA V2.2",
  "type":                     "object",
  "required":                 [ "Header", "Time" ],
  "properties":               {

    "Header":                 { "type": "string", "const": "MMM-TRP-V2.2" },
    "MInstanceID":            { "type": "string" },
    "UEnvironmentID":         { "type": "string" },
    "TransactPAID":           { "type": "string" },
    "TransactPATime":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "Time":                   { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "TransactPARQ":           { "type": "object", "properties": {
      "RQ1":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "Transaction": { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Transaction.json" } } },
      "RQ2":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "SPM":         { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } } } },

    "TransactPARS":           { "type": "object", "properties": {
      "RS1":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "SPM": { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } },
      "RS2":                  { "type": "object", "properties": { "Complement": { "type": "string", "const": "With" }, "PAStatus": { "type": "array", "items": { "oneOf": [
                              { "type": "object", "properties": { "Err": { "type": "string", "enum": [ "FaultyPA", "IncID", "InsRights", "InsValue" ] } } },
                              { "type": "object", "properties": { "Ack": { "type": "string", "enum": [ "Ack" ] } } } ] } } } } } },

    "DataXMData":             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":          { "type": "string", "maxLength": 2048 } },

  "oneOf": [                  { "required": [ "TransactPARQ" ], "not": { "required": [ "TransactPARS" ] } },
                              { "required": [ "TransactPARS" ], "not": { "required": [ "TransactPARQ" ] } } ] }