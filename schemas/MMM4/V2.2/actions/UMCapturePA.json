{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/MMM4/V2.2/actions/UMCapturePA.json",
  "title":                  "UM Capture PA 2.2",
  "type":                   "object",
                            "required": [ "Header", "MInstanceID", "Time", "UMCapturePARQ", "UMCapturePARS" ], "properties": {

    "Header":               { "type": "string", "const": "MMM-1CP-V2.2" },
    "MInstanceID":          { "type": "string" },
    "UEnvironmentID":       { "type": "string" },
    "UMCapturePAID":        { "type": "string" },
    "UMCapturePATime":      { "type": "string" },

    "Time":                 { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "UMCapturePARQ":        { "type": "object", "properties": {
      "RQ1":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "Nil" },
        "ULocation":        { "type": "string" } } },
      "RQ2":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "Qualifiers":       { "type": "array", "items": { "type": "string" } } } },
      "RQ3":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "Rights":           { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RQ4":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "SPM":              { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } } } },

    "UMCapturePARS":        { "type": "object", "properties": {
      "RS1":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "Nil" },
        "Item":             { "type": "string" } } },
      "RS2":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "SpatialAttitude":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" } } },
      "RS3":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "Rights":           { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },
      "RS4":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "SPM":              { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ServicePricingModel.json" } } },
      "RS5":                { "type": "object", "properties": {
        "Complement":       { "type": "string", "const": "With" },
        "PAStatus":         { "type": "array", "items": { "oneOf": [
                            { "type": "object", "properties": {
          "Err":            { "type": "string", "enum": [ "FaultyPA", "IncID", "InsRights", "InsValue", "ULocOOR" ] } } },
                            { "type": "object", "properties": {
          "Ack":            { "type": "string", "enum": [ "Ack" ] } } } ] } } } } } },

    "DataXMData":           { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } },

  "oneOf": [                { "required": [ "UMCapturePARQ" ], "not": { "required": [ "UMCapturePARS" ] } },
                            { "required": [ "UMCapturePARS" ], "not": { "required": [ "UMCapturePARQ" ] } } ] }
