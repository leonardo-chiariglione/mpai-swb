{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/MMM4/V2.2/data/Validation.json",
  "title":                  "Validation V2.2", 
  "type":                   "object", 
  "properties":             {

    "Header":               { "type": "string", "const": "MMM-VLD-V2.2" },
    "MInstanceID":          { "type": "string" },
    "ValidationID":         { "type": "string" },
    "ValidationTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "ValidationRequest":    { "type": "object", "properties": {

      "ProcessID":          { "type": "string" },

      "Rights":             { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" } } },

    "ValidationResponse":   { "type": "object", "properties": { "Confirmation": { "type": "boolean" } } },

    "DataExchangeMetadata": { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } } }
