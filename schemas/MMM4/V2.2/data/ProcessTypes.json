
{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/MMM4/V2.2/data/ProcessTypes.json",
  "title":                  "Process Types V2.2", 
  "type":                   "object", 
  "properties":             {

    "Header":               { "type": "string", "const": "^MMM-PRT-V2.2}$" },
    "MInstanceID":          { "type": "string" },
    "humanID":              { "type": "string" },

    "ProcessID":            { "type": "string" },
    "ProcessTypesID":       { "type": "string" },

    "PPROrPPRID":           { "type": "array", "items": { "anyOf": [
                            { "type": "object", "properties": {
      "ProcessType":        { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/PersonalProfile.json" } } },
                            { "type": "object", "properties": { "ProcessID": { "type": "string" } } } ] } },
    "ProcessKinds":         { "type": "array", "items": { "type": "object", "properties": {
      "ProcessKind":        { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/ProcessKinds.json" } } } },

    "ProcessMetadata":      { "type": "array", "items": { "type": "string" } },

    "DataXMData":           {"$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } } }

