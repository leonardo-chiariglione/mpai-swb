{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/MMM4/V2.2/data/MEnvironment.json",
  "title":                  "MEnvironment V2.2", 
  "type":                   "object", 
  "properties": {

    "Header":               { "type": "string", "const": "MMM-MEN-V2.2" },
    "MInstanceID":          { "type": "string" },
    "MEnvironmentID":       { "type": "string" },
    "MEnvironmentTime":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "Capabilities":         { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Capabilities.json" },

    "RulesOrRulesID":      { "type": "array", "items": { "oneOf": [ { 
      "Rules":             { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rules.json" } },
                            { "type": "object", "properties": { 
      "RulesID":           { "type": "string" } } } ] } },

    "DataExchangeMetadata": { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } } }

