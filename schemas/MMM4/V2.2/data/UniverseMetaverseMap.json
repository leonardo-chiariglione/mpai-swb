{ "$schema":             "https://json-schema.org/draft/2020-12/schema",
  "$id":                 "https://schemas.mpai.community/MMM4/V2.2/data/UniverseMetaverseMap.json",
  "title":               "Universe Metaverse Map V2.2",
  "type":                "object",
  "properties":          {

    "Header":            { "type": "string", "const": "^MMM-UMM-V2.2" },
    "MInstanceID":       { "type": "string" },
    "MEnvironmentID":    { "type": "string" },
    "UEnvironmentID":    { "type": "string" },
    "UiMetaMapID":       { "type": "string" },
    "UiMetaMapTime":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "MapData":           { "type": "array", "items": { "type": "object", "properties": {
      "ULocationID":     { "type": "array", "items": { "type": "object", "properties": {
        "MLocations":    { "type": "array", "items": { "type": "object", "properties": {
          "MLocationID": { "type": "string" },
          "ItemID":      { "type": "string" },
          "PersonaID":   { "type": "string" } } } } } } } } } },

    "DataXMData":        {"$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":     { "type": "string", "maxLength": 2048 } } }
