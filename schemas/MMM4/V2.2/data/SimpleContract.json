{ "$schema":                    "https://json-schema.org/draft/2020-12/schema",
  "$id":                        "https://schemas.mpai.community/MMM4/V2.2/data/SimpleContract.json",
  "title":                      "Simple Contract V2.2",
  "type":                       "object",
  "required":                   ["Header", "MInstanceID", "SimpleContractID", "SimpleContractTime", "SimpleContractStatus"],
  "additionalProperties":       false,
  "properties":                 {

    "Header":                   { "type": "string", "consts": "MMM-SCT-V2.2" },
    "MInstanceID":              { "type": "string" },
    "MEnvironmentID":           { "type": "string" },
    "SimpleContractID":         { "type": "string" },
    "SimpleContractTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SenderData":               { "type": "object", "additionalProperties": false, "properties": {
      "SenderID":               { "type": "string" },
      "SenderPreValue":         { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Value.json" },
      "SPLicence":              { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Licence.json" },
      "SenderPostValue":        { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Value.json" },
      "ReceiverLicence":        { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Licence.json" },
      "SenderWalletID":         { "type": "string" } } },

    "ReceiverData":             { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": {
      "ReceiverID":             { "type": "string" },
      "ReceiverPostValue":      { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Value.json" },
      "ValueToSender":          { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Rights.json" },
      "ReceiverWalletID":       { "type": "string" } } } },

    "ServiceProviderData":      { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": {
      "ServiceProviderID":      { "type": "string" },
      "ServiceProviderWalletID":{ "type": "string" } } } },

    "DataXMData":               { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":            { "type": "string", "maxLength": 2048 } } }
