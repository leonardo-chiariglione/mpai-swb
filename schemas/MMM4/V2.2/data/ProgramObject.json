{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/MMM4/V2.2/data/ProgramObject.json",
  "title":                  "Program Object V2.2",
  "type":                   "object",
  "properties":             {

    "Header":               { "type": "string", "const": "MMM-PRG-V2.2" },
    "MInstanceID":          { "type": "string" },
    "MEnvironmentID":       { "type": "string" },
    "ProgramObjectID":      { "type": "string" },
    "ProgramObjectTime":    { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "ProgramData":          { "type": "array", "items": { "anyOf": [
                            { "type": "object", "properties": { "Length": { "type": "integer" }, "DataURI": { "type": "string", "format": "uri" } } },
                            { "type": "object", "properties": { "Data":   { "type": "string" } } },
                            { "type": "object", "properties": { "DataID": { "type": "string" } } } ] } },

    "ProgramDataQualifier": { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/ProgramQualifier.json" },

    "ProgramMetadata":      { "type": "string" },

    "CertificateID":        { "type": "string" },

    "DataXMData":           { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } } }
